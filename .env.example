# Local backend
NEXT_PUBLIC_API_URL=http://localhost:10000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO static-export source:
# - api: fetch the validated backend snapshot; production failures stop the build.
# - fixture: deterministic repo fixture for CI/tests or an intentional offline build.
SEO_BUILD_SOURCE=api
# SEO_BUILD_RETRY_DELAY_MS=250
# SEO_BUILD_COMMIT=<commit sha>
# SEO_DEPLOY_HOOK_CONFIGURED=false

# Render
# NEXT_PUBLIC_API_URL=https://paladinhubv2-server.onrender.com
# NEXT_PUBLIC_SITE_URL=https://paladinhubv2-client.onrender.com
